# MINIMAL option set for native Docker + k3s on begonia (kernel 4.14.141, UBports halium-10.0).
# Everything =y (no new modules). Chosen to AVOID options that change widely shared kernel structures
# (task_struct, bio, request_queue, net_device), because Wi-Fi/BT/GPS are stock Xiaomi vendor modules that
# are force-loaded and must keep seeing the same layouts. Dropped on purpose (optional for Docker/k3s):
#   BLK_CGROUP, BLK_DEV_THROTTLING (blkio limits), CGROUP_NET_PRIO, CGROUP_PERF, BRIDGE_VLAN_FILTERING
#   (and, silently dropped by dependencies anyway: CGROUP_HUGETLB, IPVLAN). Also NOT enabled: NF_TABLES, IP_VS.
# The full original list is kept in kernel/docker-k3s-extended.config.disabled
# POSIX_MQUEUE was first dropped, but runc ALWAYS mounts /dev/mqueue: without it no container starts (found 2026-11-26).
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_VXLAN=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
