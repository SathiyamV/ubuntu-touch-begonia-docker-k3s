# Kernel options to ADD to begonia_user_defconfig (Halium 10, kernel 4.14.141) for native Docker + k3s.
# Everything is built IN (=y), never as a module: the Wi-Fi/BT/GPS modules come from the stock Android
# vendor partition and are force-loaded, so we keep the module set unchanged.
# Deliberately NOT enabled (they change struct net / struct layouts used by those vendor modules):
#   NF_TABLES, IP_VS  -> Docker/k3s use legacy iptables + kube-proxy iptables mode instead.

# --- cgroups (container limits) ---
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_POSIX_MQUEUE=y

# --- netfilter pieces Docker / kube-proxy rules use ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y

# --- virtual networking ---
CONFIG_VXLAN=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
